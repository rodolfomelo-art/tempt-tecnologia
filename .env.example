# Copie para .env e preencha. NUNCA publique o .env.
PORT=3000

# Servidor OpenWA (https://www.open-wa.org)
OPENWA_URL=http://localhost:2785
# Chave de API do OpenWA (gerada no primeiro boot; use uma chave com escopo só de envio, se possível)
OPENWA_API_KEY=
# ID da sessão do WhatsApp criada no OpenWA e já conectada via QR code
OPENWA_SESSION_ID=

# Quem recebe os contatos do site: DDI+DDD+número, só dígitos (ex.: 5511999999999)
WHATSAPP_NOTIFY_TO=
# Número do botão "WhatsApp" do site (se vazio, usa o de cima)
WHATSAPP_PUBLIC=
